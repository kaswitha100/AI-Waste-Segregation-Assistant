# Backend Configuration
PROJECT_NAME="AI Waste Segregation Assistant"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Security
SECRET_KEY="your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (MongoDB Atlas or Local MongoDB)
# Leave as mongodb://localhost:27017 or use your Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.mongodb.net/waste_segregation_db?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="waste_segregation_db"

# Admin Initial Seed Credentials
ADMIN_EMAIL="admin@wastesegregation.ai"
ADMIN_PASSWORD="AdminPassword123!"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
